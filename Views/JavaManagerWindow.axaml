<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:CoffeeMC.App.Models"
        x:Class="CoffeeMC.App.Views.JavaManagerWindow"
        Title="Java"
        Width="720" Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        Opacity="0">

    <Window.Transitions>
        <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
        </Transitions>
    </Window.Transitions>

    <Border CornerRadius="{DynamicResource UiCornerRadius}" ClipToBounds="True"
            Background="{DynamicResource BackgroundBrush}">
        <Grid RowDefinitions="36,*">

            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{DynamicResource Java_ManagerTitle}" VerticalAlignment="Center"
                               Margin="12,0,0,0" Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                    <Button Grid.Column="1" Classes="titlebar titlebar-close" Content="✕" Click="OnCancelClick"
                            Width="46" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            FontSize="14" Background="Transparent" Foreground="{DynamicResource TextBrush}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">

                <TextBlock Grid.Row="0" Text="{DynamicResource Java_ManagerDescription}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" Opacity="0.7" FontSize="12"/>

                <ListBox x:Name="JavaList" Grid.Row="1" Margin="0,10,0,10"
                         Background="{DynamicResource PanelBrush}" SelectionChanged="OnJavaSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:JavaInstall">
                            <StackPanel Margin="6,4" Spacing="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.7"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding Executable}" FontSize="10" Opacity="0.5"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" x:Name="StatusText" FontSize="12" Opacity="0.8" Margin="0,0,0,8"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>

                <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Java_DownloadLabel}" FontSize="12" Opacity="0.7"
                               Foreground="{DynamicResource TextBrush}"/>
                    <Grid ColumnDefinitions="Auto,Auto,*" >
                        <ComboBox Grid.Column="0" x:Name="DownloadVersionCombo" Width="130">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='Java {0}'}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" x:Name="DownloadButton" Classes="accent" Content="{DynamicResource Java_Download}"
                                Click="OnDownloadClick" Margin="8,0,0,0" Padding="14,8"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextBrush}"/>
                        <ProgressBar Grid.Column="2" x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="8"
                                     Margin="12,0,0,0" VerticalAlignment="Center" IsVisible="False"
                                     Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="#E05050" FontSize="12" TextWrapping="Wrap"
                           Margin="0,0,0,8" IsVisible="False"/>

                <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary" Content="{DynamicResource Java_Refresh}" Click="OnRefreshClick" Padding="12,8"
                                Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"/>
                        <Button Classes="secondary" Content="{DynamicResource Java_AddManual}" Click="OnAddManualClick" Padding="12,8"
                                Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"/>
                        <Button x:Name="DeleteButton" Classes="danger" Content="{DynamicResource Java_Delete}" Click="OnDeleteClick"
                                Padding="12,8" IsEnabled="False" Background="Transparent" Foreground="#E05050"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary" Content="{DynamicResource Java_UseAuto}" Click="OnUseAutoClick" Padding="12,8"
                                Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"/>
                        <Button x:Name="SelectButton" Classes="accent" Content="{DynamicResource Java_Select}" Click="OnSelectClick"
                                Padding="14,8" IsEnabled="False"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
