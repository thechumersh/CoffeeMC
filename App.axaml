<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CoffeeMC.App"
             x:Class="CoffeeMC.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>

            <!-- Значения по умолчанию (кофейная тёмная тема). Реальная тема применяется
                 в коде через MainWindow.ApplyTheme(...) и поддерживает 5 вариантов —
                 см. Services/ThemeCatalog.cs — а не только этот встроенный Dark/Light. -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#3B211D"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#2E1815"/>
            <SolidColorBrush x:Key="BorderColorBrush" Color="#D9A066"/>
            <SolidColorBrush x:Key="TextBrush" Color="#F0DCC4"/>

            <SolidColorBrush x:Key="AccentBrush" Color="#E8A33D"/>
            <CornerRadius x:Key="UiCornerRadius">6</CornerRadius>

            <Color x:Key="SystemAccentColor">#E8A33D</Color>
            <Color x:Key="SystemAccentColorLight1">#F0B85E</Color>
            <Color x:Key="SystemAccentColorLight2">#F5CC85</Color>
            <Color x:Key="SystemAccentColorLight3">#FADFAC</Color>
            <Color x:Key="SystemAccentColorDark1">#C98A2E</Color>
            <Color x:Key="SystemAccentColorDark2">#A96F20</Color>
            <Color x:Key="SystemAccentColorDark3">#8A5714</Color>

        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button.nav">
            <Setter Property="CornerRadius" Value="{DynamicResource UiCornerRadius}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="Button.nav:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="CornerRadius" Value="{DynamicResource UiCornerRadius}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.accent:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="CornerRadius" Value="{DynamicResource UiCornerRadius}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="Button.secondary:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="CornerRadius" Value="{DynamicResource UiCornerRadius}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#33E05050"/>
        </Style>
        <Style Selector="Button.danger:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.titlebar">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.titlebar:pointerover">
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="Button.titlebar-close:pointerover">
            <Setter Property="Background" Value="#E05050"/>
        </Style>

        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="{DynamicResource UiCornerRadius}"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.swatch:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.swatch-selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Opacity" Value="0.25"/>
        </Style>

        <!-- Контекстные меню и выпадающие панели — в цвет лаунчера (раньше были серыми) -->
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource UiCornerRadius}"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource UiCornerRadius}"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="Opacity" Value="0.95"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="ToggleButton.settingsTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="CornerRadius" Value="{DynamicResource UiCornerRadius}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.settingsTab:pointerover">
            <Setter Property="Background" Value="#20FFFFFF"/>
        </Style>
        <Style Selector="ToggleButton.settingsTab:checked">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="StackPanel.settingsSubPanel">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.settingsCard">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource UiCornerRadius}"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BoxShadow" Value="0 2 10 0 #30000000"/>
        </Style>

        <Style Selector="TextBlock.cardTitle">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

    </Application.Styles>
</Application>